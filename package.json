{
  "name": "deblocker",
  "version": "1.0.0",
  "description": "A modern, self-hostable web proxy interface powered by MercuryWorkshop's Scramjet.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./dist --ignore ./src/client src/server/index.ts --dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/client/tsconfig.json",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@mercuryworkshop/epoxy-transport": "3.0.1",
    "@mercuryworkshop/libcurl-transport": "2.0.5",
    "@mercuryworkshop/scramjet": "2.0.67-alpha.2",
    "@mercuryworkshop/scramjet-controller": "0.0.14",
    "@mercuryworkshop/scramjet-utils": "0.0.3",
    "@mercuryworkshop/wisp-js": "0.5.0",
    "express": "^5.2.1",
    "proxy-addr": "^2.0.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/proxy-addr": "^2.0.3",
    "@types/ws": "^8.18.2",
    "playwright-core": "^1.61.1",
    "tsx": "^4.23.14",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "ws": "^8.22.0"
  }
}
