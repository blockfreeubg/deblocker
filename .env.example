# Deblocker configuration. Copy to .env (or set these in your service manager / container).
# Every variable is optional; the values shown are the defaults.
# Node does not read .env files by itself: use `node --env-file=.env dist/server/index.js`,
# systemd's EnvironmentFile=, or docker's --env-file.

# --- server -------------------------------------------------------------------
# Port and interface to listen on. Bind to 127.0.0.1 when a reverse proxy runs on the same machine.
PORT=8080
HOST=0.0.0.0

# URL path Deblocker is served under, e.g. /deblocker when it shares a domain with other apps.
# The reverse proxy must forward the full path (do not strip the prefix).
BASE_PATH=/

# Trust X-Forwarded-* headers from a reverse proxy (needed for correct client IPs, rate limits and
# Secure cookies). Use "loopback" when the proxy runs on the same machine, a hop count (e.g. 1),
# or a comma-separated list of proxy IPs/CIDRs. Never "true" on a server reachable directly.
TRUST_PROXY=false

# error | warn | info | debug. Only "debug" logs the destinations visitors connect to.
LOG_LEVEL=info

# --- proxy engine ---------------------------------------------------------------
# Browser-side transport that tunnels traffic over Wisp: libcurl (default) or epoxy.
TRANSPORT=libcurl

# Serve a locally built Scramjet instead of the npm package (see README "Building Scramjet from source").
# SCRAMJET_DIST_DIR=/path/to/scramjet/packages/core/dist
# SCRAMJET_CONTROLLER_DIST_DIR=/path/to/scramjet/packages/controller/dist

# --- destination policy -----------------------------------------------------------
# Ports proxied connections may use. Comma-separated ports or ranges (e.g. 80,443,8000-8100), or * for any.
ALLOWED_PORTS=80,443

# Allow connections to loopback, private (10.x, 192.168.x, ...), link-local and other non-public
# addresses. Leave false on any public server: true lets visitors reach your internal network.
ALLOW_PRIVATE_DESTINATIONS=false

# Only allow these hosts (and their subdomains). Empty = any public host.
# DESTINATION_ALLOWLIST=wikipedia.org,wikimedia.org

# Never allow these hosts (and their subdomains). Applied before the allowlist.
# DESTINATION_BLOCKLIST=example.com

# Concurrent Wisp WebSocket connections per client IP, and streams per connection.
MAX_CONNECTIONS_PER_IP=24
MAX_STREAMS_PER_CONNECTION=128

# --- access control ----------------------------------------------------------------
# Require visitors to enter this key once before the proxy backend accepts them (min. 8 characters).
# ACCESS_KEY=change-me-to-something-long

# Secret used to sign session cookies (min. 32 characters). If unset, a random secret is generated at
# start-up, so visitors must re-enter the access key after every restart.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=

# How long an access-key session lasts.
SESSION_TTL_HOURS=168

# Extra origins allowed to open the Wisp WebSocket (the site's own origin is always allowed).
# Only needed if your reverse proxy rewrites the Host header.
# ALLOWED_ORIGINS=https://proxy.example.com

# --- interface defaults --------------------------------------------------------------
# duckduckgo | google | bing | brave | startpage | wikipedia, or a URL template containing %s.
DEFAULT_SEARCH_ENGINE=duckduckgo

# Quick links shown on the home page until a visitor customises them: "Title|URL" pairs, comma-separated.
# DEFAULT_QUICK_LINKS=Wikipedia|https://www.wikipedia.org/,GitHub|https://github.com/
